# ==============================================================================
# AI COMPANY HEADQUARTERS - ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env.local and populate with your production credentials
# ==============================================================================

# Database & Auth (Supabase)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# AI Engine Providers (Optional - fallback to simulated local AI engine if unset)
OPENAI_API_KEY=sk-your-openai-api-key
GEMINI_API_KEY=AIzaSy-your-gemini-api-key

# Automation Infrastructure (n8n Webhook Endpoint)
NEXT_PUBLIC_N8N_WEBHOOK_URL=https://your-n8n-instance.com/webhook/ai-headquarters

# Application Mode (production / development / demo)
NEXT_PUBLIC_APP_ENV=development
